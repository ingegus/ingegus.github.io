---
// components/Title.astro
const { level = 1,id="", className = "" } = Astro.props as {
  id?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  className?: string;
};
---

{level === 1 && <h1 id={id} class={`text-5xl lg:text-6xl font-black leading-tight tracking-tight text-primary ${className}`}><slot /></h1>}
{level === 2 && <h2 id={id} class={`text-3xl lg:text-4xl font-bold text-primary mb-4 ${className}`}><slot /></h2>}
{level === 3 && <h3 id={id} class={`text-2xl font-bold mb-3 text-primary  ${className}`}><slot /></h3>}
{level === 4 && <h4 id={id} class={`text-xl font-bold mb-2 text-primary ${className}`}><slot /></h4>}


